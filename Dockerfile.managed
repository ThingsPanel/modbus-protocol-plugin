# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/tp-plugin-modbus .

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/tp-plugin-modbus /app/tp-plugin-modbus
COPY configs/managed.yaml /app/config.yaml
COPY form_config.json form_voucher.json form_voucher_type.json /app/
USER 65534:65534
EXPOSE 1502 1503
ENTRYPOINT ["/app/tp-plugin-modbus"]
